{
  "manifest_version": 3,
  "name": "mediadownloader",
  "version": "0.2.3",
  "description": "Download original-resolution images and videos with one click from Instagram, X (Twitter), YouTube posts and Reddit.",
  "permissions": [
    "downloads",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://www.youtube.com/*",
    "https://www.reddit.com/*",
    "https://api.redgifs.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "mediadownloader settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*"
      ],
      "js": [
        "shared/settings.js",
        "shared/report.js",
        "sites/instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.instagram.com/*"
      ],
      "js": [
        "sites/instagram-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "shared/settings.js",
        "shared/report.js",
        "sites/x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "sites/x-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared/settings.js",
        "shared/report.js",
        "sites/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "sites/youtube-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/*"
      ],
      "js": [
        "shared/settings.js",
        "shared/report.js",
        "sites/reddit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
